<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Exact alarm scheduling for reminders. SCHEDULE_EXACT_ALARM is
         pre-granted on Android 12; from Android 13 the user would have to
         enable it manually in settings, so alarm/reminder apps declare
         USE_EXACT_ALARM there instead, which is granted at install. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Auto Backup is deliberately off: a cloud-restored reminders.db would
         reappear in the list with none of its OS alarms armed (restore never
         runs the boot receiver). Backups are explicit instead — the user
         exports/imports a JSON file from Settings -> Backup, and import
         re-schedules through the app so alarms are genuinely re-armed. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.remind_me"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Long-press-launcher shortcuts, phase 2 (PLAN.md). Must hang
                 off the MAIN/LAUNCHER activity — that's where the launcher
                 looks for them. See res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- External reminder creation, phase 1 (PLAN.md): a
                 remindme://create deep link, from another app, a URL, or a
                 launcher shortcut (phase 2). BROWSABLE lets a plain <a>
                 link/browser address bar trigger it too. Handled in
                 MainActivity.kt via the same replay-guarded, retry-until-ready
                 delivery as a notification action tap — except with no
                 details, which is a navigate-only request (open the New
                 Reminder form) and therefore exempt from that guard, since
                 there is nothing for it to duplicate. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="remindme" android:host="create" />
                <!-- Navigate-only, phase 5 (PLAN.md): what the reminder-list
                     widget's rows fire. Deliberately parsed without touching
                     its query string (MainActivity.kt) — this filter is
                     BROWSABLE, so any web page can send one, and a host
                     documented as "just open the list" must not become a
                     second create surface outside the replay guard. -->
                <data android:scheme="remindme" android:host="reminders" />
            </intent-filter>

            <!-- Share-sheet target: "share text -> Remind Me!" from any app.
                 Arrives with no time set, so it always prefills rather than
                 auto-creating (see MainActivity.kt / src/lib/createRequest.ts). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Voice-driven reminder creation, headless path (PLAN.md follow-up):
             the reminder-list widget's mic button launches this instead of
             MainActivity, so a tap never visibly opens the app.
             Theme.VoiceTrampoline (see themes.xml) means nothing is ever
             drawn; see VoiceQuickCreateActivity.kt for the recognizer ->
             parse -> CreateReminderReceiver flow.

             Not exported: reached only via an explicit PendingIntent built by
             this app itself (ReminderListWidgetProvider.voiceReminder), same
             as MainActivity's own widget-triggered PendingIntents — a
             PendingIntent runs with its creating app's identity regardless of
             which process calls send() on it (the launcher, here), so this
             does not need the launcher-facing exported=true a widget's own
             <receiver> does. -->
        <activity
            android:name=".VoiceQuickCreateActivity"
            android:theme="@style/Theme.VoiceTrampoline"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <!-- Preset snooze buttons are registered with `foreground: false`, so
             the notification plugin sends their taps here as a package-scoped
             broadcast instead of launching MainActivity. Without this
             registration the PendingIntent resolves to nothing and tapping a
             snooze button would silently do nothing at all. -->
        <receiver
            android:name=".SnoozeActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.tauri.notification.BACKGROUND_ACTION" />
            </intent-filter>
        </receiver>

        <!-- Headless reminder creation, phase 3 (PLAN.md): a broadcast arms a
             reminder with no UI and without launching the app — the entry
             point for automation apps (Tasker, HTTP Shortcuts) and, from
             phase 4, the home-screen widget's preset buttons. See
             CreateReminderReceiver.kt and the contract in README.md.

             Deliberately exported: a signature or custom permission would be
             unholdable by exactly the third-party automation apps this exists
             for, so the mitigation is input validation, not access control —
             the extras only ever become notification body text. Note a
             manifest-declared receiver gets no implicit broadcasts since API
             26, so callers must address it by component or package. -->
        <receiver
            android:name=".CreateReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="software.greysky.remindme.CREATE_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- Quick-create home-screen widget, phase 4 (PLAN.md): preset
             buttons that arm a reminder through CreateReminderReceiver
             without launching the app, plus a button that opens the New
             Reminder form via the phase-1 deep link. See
             QuickCreateWidgetProvider.kt and res/xml/quick_create_widget_info.xml.

             Exported because every app widget provider must be — the launcher
             is a different process and has to be able to deliver
             APPWIDGET_UPDATE. The provider's own click action deliberately has
             no intent filter: its PendingIntents name the component
             explicitly, so it stays off the implicit-broadcast surface, and
             anything that did reach it is range-checked there and validated
             again by CreateReminderReceiver. -->
        <receiver
            android:name=".QuickCreateWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_create_widget_info" />
        </receiver>

        <!-- Reminder-list home-screen widget, phase 5 (PLAN.md): renders the
             denormalized snapshot the frontend pushes through the
             AndroidNative bridge (WidgetSnapshot.kt), so Kotlin never reads
             reminders.db and the app's formatting logic stays in one
             language. Exported for the same reason as the quick-create
             provider above — the launcher is a different process. -->
        <receiver
            android:name=".ReminderListWidgetProvider"
            android:label="@string/list_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/reminder_list_widget_info" />
        </receiver>

        <!-- Backs that widget's ListView. RemoteViews.RemoteCollectionItems
             would make this file unnecessary, but it is API 31+ and minSdk is
             26. BIND_REMOTEVIEWS restricts binding to the system's
             AppWidgetService, which is the only thing that should reach it. -->
        <service
            android:name=".ReminderListWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
