<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Exact alarm scheduling for reminders. SCHEDULE_EXACT_ALARM is
         pre-granted on Android 12; from Android 13 the user would have to
         enable it manually in settings, so alarm/reminder apps declare
         USE_EXACT_ALARM there instead, which is granted at install. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Auto Backup is deliberately off: a cloud-restored reminders.db would
         reappear in the list with none of its OS alarms armed (restore never
         runs the boot receiver). Backups are explicit instead — the user
         exports/imports a JSON file from Settings -> Backup, and import
         re-schedules through the app so alarms are genuinely re-armed. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.remind_me"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Preset snooze buttons are registered with `foreground: false`, so
             the notification plugin sends their taps here as a package-scoped
             broadcast instead of launching MainActivity. Without this
             registration the PendingIntent resolves to nothing and tapping a
             snooze button would silently do nothing at all. -->
        <receiver
            android:name=".SnoozeActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.tauri.notification.BACKGROUND_ACTION" />
            </intent-filter>
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
