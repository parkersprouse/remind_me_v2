<?xml version="1.0" encoding="utf-8"?>
<!-- Spin frame for the reminder-list widget's refresh button
     (ReminderListWidgetProvider.spinAndRefresh): ic_widget_refresh rotated
     315° about its center. RemoteViews has no way to animate a
     rotation transform on a per-frame basis reliably across launcher
     implementations, so the "spin" is a hand-rolled flipbook of these
     pre-rotated frames swapped in via setImageViewResource — the same
     @RemotableViewMethod already relied on for every other icon in this
     widget, so it is unconditionally safe rather than merely convenient. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <group
      android:pivotX="12"
      android:pivotY="12"
      android:rotation="315">
    <path
        android:pathData="M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z"
        android:fillColor="@color/widget_button_text" />
  </group>
</vector>
