<?xml version="1.0" encoding="utf-8"?>
<!-- Backing panel for the reminder-list widget (PLAN.md, phase 5).

     Unlike phase 4's widget_background this is drawn as an ImageView's `src`,
     not a background, so ReminderListWidgetProvider can recolor it with the
     user's accent-derived surface color through setColorFilter — tinting a
     rounded *background* is not possible below API 31. The white below is
     therefore a placeholder: SRC_ATOP replaces it while preserving the
     rounded alpha. It is only ever visible if the tint fails to apply. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <solid android:color="#FFFFFFFF" />
  <corners android:radius="24dp" />
</shape>
