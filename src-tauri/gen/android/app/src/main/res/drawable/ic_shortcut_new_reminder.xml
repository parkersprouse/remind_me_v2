<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher long-press shortcut icon (PLAN.md, phase 2). Deliberately a
     filled disc in the launcher-icon background colour with a white glyph,
     not a reuse of ic_stat_logo: that one is alpha-only white (Android draws
     notification small icons from alpha alone), which would be invisible
     against a light launcher's shortcut sheet. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
  <path
      android:pathData="M24,24m-24,0a24,24 0,1 1,48 0a24,24 0,1 1,-48 0"
      android:fillColor="@color/ic_launcher_background" />
  <path
      android:pathData="M21.5,12H26.5V21.5H36V26.5H26.5V36H21.5V26.5H12V21.5H21.5Z"
      android:fillColor="#FFFFFF" />
</vector>
