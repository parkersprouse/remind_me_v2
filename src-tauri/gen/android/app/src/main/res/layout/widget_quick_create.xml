<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-create widget (PLAN.md, phase 4). Deliberately plain RemoteViews:
     a LinearLayout tree of TextViews with drawable backgrounds is everything
     a row of buttons needs, and pulling Jetpack Glance/Compose into this
     hand-edited Gradle tree would reopen exactly the R8 failure class this
     repo has already been bitten by twice (see CLAUDE.md).

     The status line doubles as the header: it starts as the hint and is
     replaced with a confirmation by QuickCreateWidgetProvider, which keeps
     the widget one cell shorter than a separate line would. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:text="@string/widget_hint"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/widget_new_reminder"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_icon_button_background"
        android:src="@drawable/ic_widget_plus"
        android:scaleType="centerInside"
        android:contentDescription="@string/shortcut_new_reminder_long" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_preset_0"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_button_background"
        android:gravity="center"
        android:text="@string/widget_preset_15m"
        android:textColor="@color/widget_button_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_preset_1"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_button_background"
        android:gravity="center"
        android:text="@string/widget_preset_30m"
        android:textColor="@color/widget_button_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_preset_2"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_background"
        android:gravity="center"
        android:text="@string/widget_preset_1h"
        android:textColor="@color/widget_button_text"
        android:textSize="15sp" />
  </LinearLayout>
</LinearLayout>
