# Copy this file to `keystore.properties` (same directory) and fill in the real
# values. `keystore.properties` and `*.jks` are gitignored — never commit either.
#
# `storeFile` is an ABSOLUTE path so the keystore can live outside the repo tree
# (recommended: ~/.android-keystores/). build.gradle.kts reads these four keys to
# assemble the release signingConfig; if this file is absent the release build
# is simply left unsigned. See RELEASE.md for the full process.

storeFile=/ABSOLUTE/PATH/TO/remind-me-release.jks
storePassword=CHANGE_ME
keyAlias=remind-me
keyPassword=CHANGE_ME
