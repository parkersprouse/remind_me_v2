{
  "name": "remind_me",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "engines": {
    "node": "^24",
    "pnpm": "^11"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:android": "tauri android dev",
    "build:android": "tauri android build --apk",
    "preview:android": "tauri android run",
    "tauri": "tauri",
    "version:bump": "node scripts/bump-version.mjs",
    "release:build": "tauri android build --apk",
    "release:verify": "APK=src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release.apk; SDK=\"${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}\"; APKSIGNER=$(ls \"$SDK\"/build-tools/*/apksigner 2>/dev/null | sort -V | tail -1); \"$APKSIGNER\" verify --print-certs \"$APK\"",
    "release": "node scripts/release.mjs",
    "publish": "node scripts/publish-release.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@saurl/tauri-plugin-safe-area-insets-css-api": "^0.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-sql": "~2.4.0",
    "@tauri-apps/plugin-store": "~2.4.3",
    "chrono-node": "^2.10.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.6.0",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-unicorn": "^71.1.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
